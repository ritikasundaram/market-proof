# Copy to .env.local for local development. Never commit real keys.

# Required — Gemini powers all 7 agents via Google's OpenAI-compatible
# endpoint (default model: gemini-3.5-flash-lite). Get a key at
# https://aistudio.google.com/apikey (free tier available).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Alternative provider: OpenAI (strict structured outputs).
# Set LLM_PROVIDER=openai to use it instead.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Provider switch. "gemini" works in MVP; "openai" is implemented;
# "anthropic" is a stub awaiting lib/ai/anthropic.ts implementation.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Live web search (Serper Google Search API). Optional but recommended:
# without it, reports are labeled "model knowledge only, verify before use."
# Free tier: 2,500 searches, no card — https://serper.dev
SEARCH_PROVIDER=serper
SERPER_API_KEY=
SEARCH_MAX_RESULTS=5
