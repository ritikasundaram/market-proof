# Copy to .env.local for local development. Never commit real keys.

# Required — OpenAI powers all 7 agents (default model: gpt-4o-mini).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Provider switch. "openai" works in MVP; "anthropic" is a stub awaiting
# lib/ai/anthropic.ts implementation.
LLM_PROVIDER=openai
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Live web search (Serper Google Search API). Optional but recommended:
# without it, reports are labeled "model knowledge only, verify before use."
# Free tier: 2,500 searches, no card — https://serper.dev
SEARCH_PROVIDER=serper
SERPER_API_KEY=
SEARCH_MAX_RESULTS=5
